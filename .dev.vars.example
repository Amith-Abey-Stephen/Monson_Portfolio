# ==============================================================================
# Cloudflare Pages / Wrangler Local Secrets (.dev.vars)
# Copy to `.dev.vars` for local Cloudflare Pages development:
# cp .dev.vars.example .dev.vars
# ==============================================================================

# Required: Admin password to unlock and publish changes from /edit
ADMIN_PASSWORD="your-strong-password-here"

# Optional: Custom domain or public development URL for your R2 media bucket
R2_PUBLIC_URL="https://your-r2-custom-domain.com"
