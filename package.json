{
  "name": "monson-sunny-portfolio",
  "version": "1.0.0",
  "description": "Monson Sunny — UI/UX Designer portfolio. Production-ready static site.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --ext .js,.html",
    "format": "prettier --write \"**/*.{js,css,html,json}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json}\"",
    "audit:html": "html-validate \"*.html\"",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prepare": "husky || true"
  },
  "keywords": [
    "portfolio",
    "ui-ux",
    "design",
    "vite",
    "static-site"
  ],
  "author": "Monson Sunny <hello@monsonsunny.com>",
  "license": "UNLICENSED",
  "devDependencies": {
    "eslint": "^9.12.0",
    "html-validate": "^8.15.0",
    "prettier": "^3.3.3",
    "sharp": "^0.33.4",
    "svgo": "^4.1.0",
    "vite": "^5.4.0",
    "vite-plugin-image-optimizer": "^1.1.8"
  }
}
