---
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Monson Sunny® — UI/UX Designer · Digital Creative",
  description = "Monson Sunny — UI/UX Designer crafting thoughtful digital experiences that feel as good as they look. Product design, UX strategy & design systems.",
  image = "/og-cover.jpg"
} = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Monson Sunny" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F9F6F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0E0E" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href="https://monsonsunny.com/" />

    <!-- Preconnect & DNS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Preload LCP -->
    <link
      rel="preload"
      href="/assets/images/hero-workspace.jpg"
      as="image"
      imagesrcset="/assets/images/hero-workspace.jpg 900w"
      imagesizes="(max-width: 720px) 100vw, 50vw"
      fetchpriority="high"
    />

    <!-- Fonts (display=swap) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&family=Manrope:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicons & PWA -->
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/images/favicon.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Monson Sunny" />
    <meta name="application-name" content="Monson Sunny" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Monson Sunny" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://monsonsunny.com/" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Monson Sunny portfolio preview" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:creator" content="@monsonsunny" />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://monsonsunny.com/#person",
            "name": "Monson Sunny",
            "jobTitle": "UI/UX Designer",
            "url": "https://monsonsunny.com/",
            "image": "https://monsonsunny.com/assets/images/avatars/monson.jpg",
            "sameAs": [
              "https://linkedin.com/in/monsonsunny",
              "https://behance.net/monsonsunny",
              "https://dribbble.com/monsonsunny",
              "https://instagram.com/monsonsunny"
            ],
            "knowsAbout": ["UX Strategy", "UI Design", "Design Systems", "Product Design", "Prototyping"]
          },
          {
            "@type": "WebSite",
            "@id": "https://monsonsunny.com/#website",
            "url": "https://monsonsunny.com/",
            "name": "Monson Sunny — UI/UX Designer",
            "description": "Thoughtful digital experiences that feel as good as they look.",
            "publisher": { "@id": "https://monsonsunny.com/#person" },
            "inLanguage": "en-IN"
          }
        ]
      }
    </script>

    <!-- No-JS fallback -->
    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
        .divider {
          transform: scaleX(1);
        }
        .cursor {
          display: none !important;
        }
      </style>
    </noscript>
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="cursor" id="cursor" aria-hidden="true">
      <span class="cursor-label" id="cursorLabel">View</span>
    </div>
    <div class="cursor-trail" id="cursorTrail" aria-hidden="true"></div>

    <slot />

    <script src="../scripts/main.js"></script>
  </body>
</html>
