---
import type { ServiceItem } from '../lib/content-model';

interface Props {
  services: ServiceItem[];
}

const { services } = Astro.props;
const visibleServices = services.filter((s) => s.visible !== false);
---

<section class="services" id="services" aria-labelledby="services-heading">
  <div>
    <div class="label">What I Do</div>
    <h2 id="services-heading" class="reveal" style="margin-top: 10px">
      Designing from
      <br />
      <i>idea to interface.</i>
    </h2>
    <p
      class="reveal"
      style="color: var(--muted2); font-size: 15px; line-height: 1.6; margin-top: 12px; max-width: 420px"
    >
      End-to-end product design — from discovery and strategy to polished, scalable interfaces.
    </p>
  </div>
  <div class="service-list" role="list">
    {visibleServices.map((service) => (
      <div class="service-row" data-cursor="EXPLORE ↗" role="listitem" tabindex="0">
        <span class="s-num">{service.num}</span>
        <div>
          <h3>{service.title}</h3>
          <div class="s-desc">{service.desc}</div>
        </div>
        <div style="display: flex; gap: 10px; align-items: center">
          <div class="service-preview">
            <img
              loading="lazy"
              decoding="async"
              width="300"
              height="200"
              src={service.image}
              alt={`${service.title} preview`}
            />
          </div>
          <span class="s-arrow" aria-hidden="true">↗</span>
        </div>
      </div>
    ))}
  </div>
</section>
