---
interface Props {
  brand?: string;
  email?: string;
}

const {
  brand = 'MONSON SUNNY®',
  email = 'hello@monsonsunny.com'
} = Astro.props;
---

<header>
  <nav class="nav" id="nav" aria-label="Primary">
    <a class="nav-left" href="#top" aria-label={`${brand} — home`}>{brand}</a>
    <div class="nav-center" role="list">
      <a href="#work" role="listitem">Work.</a>
      <a href="#about" role="listitem">About.</a>
      <a href="#playground" role="listitem">Playground.</a>
      <a href="#journal" role="listitem">Journal.</a>
    </div>
    <a class="nav-cta desktop" href="#contact">
      Let's Talk
      <span class="cta-arrow" aria-hidden="true">↗</span>
    </a>
    <button
      class="hamburger"
      id="hamburger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span></span>
      <span></span>
    </button>
  </nav>
</header>

<div class="mobile-menu" id="mobileMenu" hidden>
  <a href="#work">
    Work
    <span>01</span>
  </a>
  <a href="#about">
    About
    <span>02</span>
  </a>
  <a href="#playground">
    Playground
    <span>03</span>
  </a>
  <a href="#journal">
    Journal
    <span>04</span>
  </a>
  <a href="#contact">
    Contact
    <span>↗</span>
  </a>
  <div style="margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap">
    <a
      href={`mailto:${email}`}
      style="
        font-size: 14px;
        font-family: var(--sans);
        letter-spacing: 0.02em;
        border: 1px solid var(--dark);
        border-radius: 999px;
        padding: 10px 16px;
      "
    >
      {email} ↗
    </a>
  </div>
</div>
