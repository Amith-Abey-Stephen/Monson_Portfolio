---
import type { AboutContent } from '../lib/content-model';

interface Props {
  content: AboutContent;
}

const { content } = Astro.props;
---

<section class="about" id="about" aria-labelledby="about-heading">
  <div class="about-media parallax" data-speed="0.04">
    <img
      loading="lazy"
      decoding="async"
      width="900"
      height="1350"
      src={content.imageMain}
      alt="Monson Sunny portrait — designer by profession, problem solver by nature"
    />
    <div class="about-badge">
      <span class="av">
        <img
          loading="lazy"
          decoding="async"
          width="200"
          height="300"
          src={content.imageSmall}
          alt="Monson Sunny — avatar"
        />
      </span>
      <div>
        <div style="font-size: 13px; font-weight: 700; color: var(--dark)">Monson Sunny</div>
        <div style="font-size: 11px; color: var(--muted2)">{content.role}</div>
      </div>
      <span
        style="
          width: 26px;
          height: 26px;
          border-radius: 50%;
          background: #111;
          color: #fff;
          display: grid;
          place-items: center;
          font-size: 11px;
        "
        aria-hidden="true"
      >
        ↗
      </span>
    </div>
  </div>
  <div class="about-content">
    <div class="label">The Person Behind The Pixels</div>
    <h2 id="about-heading" class="reveal" style="margin-top: 10px">
      {content.heading}
    </h2>
    <p class="reveal">
      {content.subtext}
    </p>
    <div class="about-meta reveal">
      <div>
        <strong>Based in</strong>
        {content.location}
      </div>
      <div>
        <strong>Role</strong>
        {content.role}
      </div>
    </div>
    <div class="about-stats reveal">
      <div>
        <b>{content.stats.stat1Number}</b>
        <span>{content.stats.stat1Label}</span>
      </div>
      <div>
        <b>{content.stats.stat2Number}</b>
        <span>{content.stats.stat2Label}</span>
      </div>
      <div>
        <b>{content.stats.stat3Number}</b>
        <span>{content.stats.stat3Label}</span>
      </div>
    </div>
  </div>
</section>
