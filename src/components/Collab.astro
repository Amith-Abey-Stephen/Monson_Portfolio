---
import type { CollabContent } from '../lib/content-model';

interface Props {
  content: CollabContent;
}

const { content } = Astro.props;
---

<section class="collab reveal" aria-labelledby="collab-heading" data-cms-section="collab">
  <h2 id="collab-heading" data-cms-bind="collab.heading">
    {content.heading}
  </h2>
  <p data-cms-bind="collab.subtext">
    {content.subtext}
  </p>
  <a class="btn-primary magnetic" href={content.btnLink} data-cursor="LET'S TALK ↗" data-cms-bind="collab.btnText">
    {content.btnText}
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M1 13L13 1M13 1H3.5M13 1V10.5" stroke="currentColor" stroke-width="1.4" />
    </svg>
  </a>
</section>
