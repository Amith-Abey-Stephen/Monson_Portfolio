---
import type { ContactContent, SocialLink } from '../lib/content-model';

interface Props {
  content: ContactContent;
  socials: SocialLink[];
}

const { content, socials } = Astro.props;
---

<section class="final" id="contact" aria-labelledby="contact-heading">
  <div class="final-grid">
    <div>
      <h2 id="contact-heading">
        Let's make
        <br />
        <i>something</i>
        <br />
        great.
      </h2>
      <p class="final-sub">{content.subtext}</p>
      <a class="email-cta magnetic" href={`mailto:${content.email}`}>
        {content.email}
        <span aria-hidden="true">↗</span>
      </a>
      <div class="social" aria-label="Social links">
        {socials.map((soc) => (
          <a href={soc.url} target="_blank" rel="noopener noreferrer" aria-label={soc.platform}>
            {soc.label}
          </a>
        ))}
      </div>
    </div>
    <div style="display: flex; flex-direction: column; align-items: end; gap: 24px">
      <div class="badge-rotate" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs><path id="circle" d="M60,60 m-48,0 a48,48 0 1,1 96,0 a48,48 0 1,1 -96,0" /></defs>
          <text fill="rgba(255,255,255,.7)" font-size="9.5" letter-spacing="2.2" font-family="Inter">
            <textPath href="#circle">AVAILABLE FOR WORK · LET'S CREATE · AVAILABLE FOR WORK ·</textPath>
          </text>
        </svg>
        <span class="badge-dot">↗</span>
      </div>
      <div style="text-align: right; color: rgba(255, 255, 255, 0.45); font-size: 12px; line-height: 1.6">
        <div
          style="
            color: #fff;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-size: 11px;
          "
        >
          {content.responseTime}
        </div>
        {content.locationNote.split('\n').map((line, idx) => (
          <>
            {line}
            {idx === 0 && <br />}
          </>
        ))}
      </div>
    </div>
  </div>
  <div class="final-bottom">
    <span>© 2026 Monson Sunny — UI/UX Designer crafting thoughtful digital experiences.</span>
    <span>Designed with intention.</span>
  </div>
</section>
