---
import type { HeroContent } from '../lib/content-model';

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <div class="hero-bg-num" aria-hidden="true">01</div>
  <div>
    <div class="eyebrow">{content.eyebrow}</div>
    <h1 id="hero-heading">
      <span class="line">
        <span>
          {content.headingLine1.split(' ').slice(0, -1).join(' ')}
          <i>{content.headingLine1.split(' ').slice(-1)}</i>
        </span>
      </span>
      <span class="line">
        <span>
          {content.headingLine2.split(' ').slice(0, -1).join(' ')}
          <i>{content.headingLine2.split(' ').slice(-1)}</i>
        </span>
      </span>
      <span class="line"><span>{content.headingLine3}</span></span>
    </h1>
    <p class="hero-desc">
      {content.description}
    </p>
    <div class="hero-ctas">
      <a class="btn-primary magnetic" href={content.primaryCtaLink} data-cursor="LET'S TALK ↗">
        {content.primaryCtaText}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 13L13 1M13 1H3.5M13 1V10.5" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </a>
      <a class="scroll-hint" href="#intro" aria-label="Scroll to introduction">
        <span class="line-v" aria-hidden="true"></span>
        {content.scrollHintText}
      </a>
    </div>
  </div>

  <div class="hero-visual">
    <div class="hero-card parallax" data-speed="0.06">
      <div class="hero-card-top">
        <div class="dots" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <span>monson — workspace / 2026</span>
        <span>● Live</span>
      </div>
      <div class="hero-card-body">
        <div class="hero-ui-left">
          <div class="mini-nav" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="hero-img-main">
            <img
              fetchpriority="high"
              decoding="async"
              width="900"
              height="599"
              src={content.workspaceImage}
              alt="Workspace UI — DeskNet community preview"
            />
            <div
              style="
                position: absolute;
                left: 10px;
                bottom: 10px;
                background: rgba(255, 255, 255, 0.92);
                backdrop-filter: blur(6px);
                border-radius: 999px;
                padding: 6px 10px;
                font-size: 11px;
                font-weight: 600;
                display: flex;
                gap: 6px;
                align-items: center;
                color: var(--dark);
              "
            >
              ◐ DeskNet — Community Workspace
            </div>
          </div>
          <div style="display: flex; gap: 8px">
            <span
              style="
                flex: 1;
                height: 28px;
                border-radius: 999px;
                background: #111;
                color: #fff;
                display: grid;
                place-items: center;
                font-size: 11px;
                font-weight: 600;
              "
            >
              Explore →
            </span>
            <span
              style="
                width: 28px;
                height: 28px;
                border-radius: 50%;
                border: 1px solid #ddd;
                display: grid;
                place-items: center;
              "
              aria-hidden="true"
            >
              ♡
            </span>
          </div>
        </div>
        <div class="hero-ui-right">
          <div class="stat-card">
            <div class="k">Design System</div>
            <div class="v">124 components</div>
            <div class="bar" aria-hidden="true"><i></i></div>
            <div style="font-size: 11px; color: var(--muted); margin-top: 6px">Tokens · Guidelines · Scale</div>
          </div>
          <div class="portrait-card">
            <img
              fetchpriority="high"
              decoding="async"
              width="600"
              height="900"
              src={content.portraitImage}
              alt="Monson Sunny portrait"
            />
            <div
              style="
                position: absolute;
                inset: auto 10px 10px 10px;
                background: rgba(255, 255, 255, 0.92);
                border-radius: 12px;
                padding: 8px 10px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: var(--dark);
              "
            >
              <div>
                <div style="font-size: 11px; font-weight: 700">Monson Sunny</div>
                <div style="font-size: 10px; color: var(--muted)">UI/UX · India</div>
              </div>
              <span
                style="
                  width: 22px;
                  height: 22px;
                  border-radius: 50%;
                  background: #111;
                  color: #fff;
                  display: grid;
                  place-items: center;
                  font-size: 10px;
                "
                aria-hidden="true"
              >
                ↗
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="float-badge" aria-hidden="true">
      <span class="avatar">
        <img
          loading="eager"
          decoding="async"
          width="100"
          height="67"
          src={content.avatarImage}
          alt="Available for work — team avatar"
        />
      </span>
      <span>Available for work</span>
      <span style="width: 8px; height: 8px; border-radius: 50%; background: #1db954; display: block"></span>
    </div>
    <div class="float-badge2" aria-hidden="true">
      <span class="icon">✦</span>
      <div>
        <div style="font-size: 12px; font-weight: 700">124+ Projects</div>
        <div style="font-size: 11px; opacity: 0.7">Shipped & live</div>
      </div>
    </div>
  </div>
</section>
