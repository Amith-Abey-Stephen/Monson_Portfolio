---
import type { PlaygroundItem } from '../lib/content-model';

interface Props {
  items: PlaygroundItem[];
}

const { items } = Astro.props;
const visibleItems = items.filter((item) => item.visible !== false);
---

<section class="playground" id="playground" aria-labelledby="playground-heading" data-cms-section="playground">
  <div class="playground-head">
    <div>
      <div class="label">Playground</div>
      <h2 id="playground-heading" class="reveal" style="margin-top: 6px">
        Not everything
        <br />
        <i>needs a case study.</i>
      </h2>
    </div>
    <div class="reveal" style="font-size: 13px; color: var(--muted); max-width: 300px; line-height: 1.6">
      UI explorations, motion studies, typography and 3D experiments — where I play and learn.
    </div>
  </div>
  <div class="pg-track" id="pgTrack" data-cms-grid="playground">
    {visibleItems.map((item, idx) => (
      <div class="pg-card" data-cursor="EXPLORE ↗" tabindex="0" role="button" aria-label={`Open ${item.title}`} data-cms-item="playground" data-id={item.id}>
        <img
          loading="lazy"
          decoding="async"
          width="600"
          height="456"
          src={item.image}
          alt={`Playground — ${item.title}`}
          data-cms-image={`playground.${idx}.image`}
        />
        <div class="pg-overlay">
          <div>
            <b data-cms-bind={`playground.${idx}.title`}>{item.title}</b>
            <br />
            <span data-cms-bind={`playground.${idx}.category`}>{item.category}</span>
          </div>
          <span class="pg-pill" aria-hidden="true">↗</span>
        </div>
      </div>
    ))}
  </div>
</section>
