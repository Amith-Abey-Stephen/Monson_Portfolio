---
interface Props {
  tools: string[];
}

const { tools } = Astro.props;
// Duplicate tools for infinite loop animation
const marqueeItems = [...tools, ...tools];
---

<div class="marquee" aria-label="Tools I use">
  <div class="marquee-label">Tools I Use</div>
  <div class="marquee-track" id="marquee" aria-hidden="true">
    {marqueeItems.map((tool) => (
      <>
        <span>{tool}</span>
        <i></i>
      </>
    ))}
  </div>
</div>
