---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page not found · Monson Sunny">
  <main class="err" aria-labelledby="err-title">
    <div>
      <div style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted)">
        Error 404
      </div>
      <h1 id="err-title">
        Lost
        <i>in space?</i>
      </h1>
      <p>The page you’re looking for doesn’t exist — or was moved. Let’s get you back to something beautiful.</p>
      <div style="margin-top: 22px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap">
        <a class="btn-primary" href="/">
          Go Home
          <span aria-hidden="true">↗</span>
        </a>
        <a class="btn-ghost" href="mailto:hello@monsonsunny.com">Contact — hello@monsonsunny.com ↗</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .err {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 40px;
    background: var(--ivory);
    text-align: center;
  }
  .err h1 {
    font-family: var(--serif);
    font-size: clamp(56px, 12vw, 160px);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
  .err h1 i {
    font-style: italic;
  }
  .err p {
    color: var(--muted2);
    max-width: 520px;
    margin: 16px auto 0;
    line-height: 1.6;
  }
</style>
