---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Hero from '../../components/Hero.astro';
import Intro from '../../components/Intro.astro';
import Work from '../../components/Work.astro';
import Philosophy from '../../components/Philosophy.astro';
import Services from '../../components/Services.astro';
import About from '../../components/About.astro';
import Playground from '../../components/Playground.astro';
import Marquee from '../../components/Marquee.astro';
import Journal from '../../components/Journal.astro';
import Collab from '../../components/Collab.astro';
import Final from '../../components/Final.astro';
import Footer from '../../components/Footer.astro';
import { DEFAULT_PORTFOLIO_CONTENT } from '../../lib/content-model';
import '../../styles/visual-cms.css';

const content = DEFAULT_PORTFOLIO_CONTENT;
---

<Layout title="Visual CMS · On-Page Portfolio Editor">
  <!-- Live Visual Website Canvas -->
  <Navigation brand={content.footer.brand} email={content.contact.email} />
  
  <main id="main">
    <Hero content={content.hero} />
    <Intro />
    <Work projects={content.projects} />
    <Philosophy content={content.philosophy} />
    <Services services={content.services} />
    <About content={content.about} />
    <Playground items={content.playground} />
    <Marquee tools={content.tools} />
    <Journal articles={content.journal} />
    <Collab content={content.collab} />
    <Final content={content.contact} socials={content.personal.socials} />
  </main>
  
  <Footer content={content.footer} />

  <!-- Floating CMS Command Bar -->
  <aside class="cms-command-bar" aria-label="Visual CMS Controls">
    <div class="cms-status-badge">
      <span class="cms-status-dot" id="cmsStatusDot"></span>
      <span id="cmsStatusText">All Changes Published</span>
    </div>

    <div class="cms-divider"></div>

    <button type="button" class="cms-cmd-btn" id="cmsBtnPreview" title="Toggle between Editing and Clean Preview">
      👁️ Preview Mode
    </button>

    <button type="button" class="cms-cmd-btn" id="cmsBtnR2Sync" title="Cloudflare R2 sync & 10-day retention">
      ☁️ Cloudflare R2
    </button>

    <div class="cms-divider"></div>

    <div class="cms-session-timer" id="cmsSessionTimer">
      ⏱️ 15m left
    </div>

    <button type="button" class="cms-cmd-btn" id="cmsBtnLock" title="Lock editor" style="color: #ef4444">
      🔒 Lock
    </button>

    <button type="button" class="cms-cmd-btn primary" id="cmsBtnPublish">
      🚀 Publish Changes
    </button>
  </aside>

  <!-- 1. Password Auth Modal -->
  <div class="cms-modal-overlay" id="cmsAuthModal">
    <div class="cms-modal-card" style="max-width: 380px; text-align: center">
      <div style="font-size: 32px; margin-bottom: 8px">🔐</div>
      <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 6px">Visual Portfolio Editor</h2>
      <p style="font-size: 13px; color: rgba(255, 255, 255, 0.65); margin-bottom: 20px">
        Enter your admin password to edit text, swap images, and manage sections live on the page.
      </p>
      <form id="cmsAuthForm">
        <input
          type="password"
          id="cmsAuthPass"
          class="cms-input-text"
          placeholder="Admin password"
          autocomplete="current-password"
          required
          style="text-align: center; margin-bottom: 14px"
        />
        <button type="submit" class="cms-cmd-btn primary" style="width: 100%; justify-content: center; padding: 10px 16px">
          Unlock Editor ↗
        </button>
        <div id="cmsAuthError" style="color: #ef4444; font-size: 12px; margin-top: 10px"></div>
      </form>
    </div>
  </div>

  <!-- 2. Media Upload & Replace Modal -->
  <div class="cms-modal-overlay" id="cmsMediaModal">
    <div class="cms-modal-card">
      <div class="cms-modal-header">
        <h3>Replace Image</h3>
        <button type="button" class="cms-modal-close" id="cmsCloseMediaModal">✕</button>
      </div>
      <div style="font-size: 13px; color: rgba(255, 255, 255, 0.7); margin-bottom: 16px">
        Upload a replacement file or paste a new image URL. The previous image will automatically be archived for <strong>10 days</strong> before permanent deletion.
      </div>
      
      <div class="cms-dropzone" id="cmsDropzone">
        <input type="file" id="cmsImageFileInput" accept="image/*" style="display: none" />
        <div style="font-size: 28px; margin-bottom: 8px">📷</div>
        <div style="font-weight: 600; font-size: 14px">Drop new image here, or click to browse</div>
        <div style="font-size: 12px; color: rgba(255, 255, 255, 0.5); margin-top: 4px">PNG, JPG, WEBP, SVG supported</div>
      </div>

      <div style="margin: 18px 0; text-align: center; font-size: 11px; color: rgba(255, 255, 255, 0.4); letter-spacing: 0.1em">
        — OR ENTER IMAGE URL —
      </div>

      <div>
        <label style="font-size: 12px; color: rgba(255, 255, 255, 0.7)">Image CDN / URL</label>
        <input type="text" id="cmsImageUrlInput" class="cms-input-text" placeholder="https://..." />
      </div>

      <div style="margin-top: 18px; display: flex; justify-content: flex-end; gap: 10px">
        <button type="button" class="cms-cmd-btn" id="cmsBtnCancelMedia" onclick="document.getElementById('cmsMediaModal').classList.remove('open')">
          Cancel
        </button>
        <button type="button" class="cms-cmd-btn primary" id="cmsBtnApplyImageUrl">
          Apply Image URL
        </button>
      </div>
    </div>
  </div>

  <!-- 3. Cloudflare R2 & 10-Day Retention Modal -->
  <div class="cms-modal-overlay" id="cmsR2Modal">
    <div class="cms-modal-card">
      <div class="cms-modal-header">
        <h3>Cloudflare R2 & 10-Day Retention</h3>
        <button type="button" class="cms-modal-close" id="cmsCloseR2Modal">✕</button>
      </div>

      <div style="display: flex; flex-direction: column; gap: 16px; font-size: 13px; line-height: 1.6; color: rgba(255, 255, 255, 0.75)">
        <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 16px">
          <div style="font-weight: 600; color: #fff; margin-bottom: 4px">☁️ One-Click Asset Sync to R2</div>
          <p style="margin: 0 0 10px 0; font-size: 12px">
            Uploads all local portfolio images to your Cloudflare R2 bucket and switches URLs to your Cloudflare CDN.
          </p>
          <button type="button" class="cms-cmd-btn primary" id="cmsBtnStartR2Sync" style="font-size: 12px">
            ☁️ Sync All Assets to Cloudflare R2
          </button>
          <div id="cmsSyncProgress" style="margin-top: 8px; font-size: 11px; color: #c9a96e; display: none"></div>
        </div>

        <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 16px">
          <div style="font-weight: 600; color: #fff; margin-bottom: 4px">🗑️ 10-Day Retention Cleanup</div>
          <p style="margin: 0 0 10px 0; font-size: 12px">
            When an image is replaced, it stays safely in the archive for 10 days. Clean any expired archived images immediately:
          </p>
          <div id="cmsArchiveCountText" style="font-size: 12px; color: #c9a96e; margin-bottom: 10px">
            0 images currently in 10-day retention
          </div>
          <button type="button" class="cms-cmd-btn" id="cmsBtnCleanExpired" style="border: 1px solid rgba(239, 68, 68, 0.4); color: #ef4444; font-size: 12px">
            🗑️ Clean Expired Images Now
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. Session Inactivity Countdown Modal -->
  <div class="cms-modal-overlay" id="cmsSessionWarnModal">
    <div class="cms-modal-card" style="max-width: 380px; text-align: center">
      <div style="font-size: 32px; margin-bottom: 8px">⏳</div>
      <h2 style="font-size: 20px; font-weight: 600; margin-bottom: 6px">Session Expiring Soon</h2>
      <p style="font-size: 13px; color: rgba(255, 255, 255, 0.65); margin-bottom: 20px">
        You have been inactive. For your security, the visual editor will automatically lock in <strong id="cmsSessionCountdown" style="color: #c9a96e">60</strong> seconds.
      </p>
      <button type="button" class="cms-cmd-btn primary" id="cmsBtnExtendSession" style="width: 100%; justify-content: center; padding: 10px 16px">
        Stay Logged In
      </button>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="cmsToast" style="
    display: none;
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 100000;
    padding: 12px 20px;
    border-radius: 999px;
    font-family: var(--sans, sans-serif);
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    transition: opacity 0.3s ease;
  "></div>

  <!-- Client-side Visual CMS Engine -->
  <script src="../../scripts/visual-cms.js"></script>
</Layout>
