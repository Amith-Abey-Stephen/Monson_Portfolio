# Copy to .env and fill in. Never commit .env.

# PostgreSQL (primary content database)
DATABASE_URL=postgresql://amith@localhost:5432/portfolio

# Managed host with a self-signed cert: pin its cert and verify fully.
# 1. openssl s_client -connect <host>:<port> -starttls postgres -showcerts </dev/null
#    | awk '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/' > certs/db-server.crt
# 2. DATABASE_URL=postgresql://user:pass@host:port/db?sslmode=verify-full&sslrootcert=certs/db-server.crt
# (certs/*.crt is public-key material and safe to commit; refresh if the host rotates its cert)

# Studio auth — comma-separated owner emails sharing one password
# (legacy single OWNER_EMAIL also still works and merges into this list)
OWNER_EMAILS=you@example.com,teammate@example.com

# Session signing secret (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-secret

# One of these two (HASH preferred). Generate a hash with:
#   npm run studio:hash
# STUDIO_PASSWORD_HASH=scrypt$…$…
STUDIO_PASSWORD=change-me
