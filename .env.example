# ==============================================================================
# Vercel Deployment & Local Development (.env.local)
# Copy to `.env.local` for local Vercel / Node development:
# cp .env.example .env.local
# ==============================================================================

# 1. Required: Admin password to unlock and publish changes from /edit
ADMIN_PASSWORD="your-strong-password-here"

# 2. Cloudflare KV Connection (Required for live multi-user sync on Vercel)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_KV_ID="your-cloudflare-kv-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# 3. Cloudflare R2 Connection (Optional: Only if uploading images to Cloudflare R2)
CLOUDFLARE_R2_BUCKET="portfolio-media"
R2_PUBLIC_URL="https://your-r2-custom-domain.com"

# 4. Optional: CMS Session & Retention Settings
VITE_SESSION_TIMEOUT_MINUTES="15"
VITE_AUTH_KEY="portfolio_admin_auth"
VITE_AUTH_EXPIRY_KEY="portfolio_admin_expiry"
VITE_IMAGE_RETENTION_DAYS="10"
